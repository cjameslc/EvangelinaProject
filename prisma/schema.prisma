// Evangelina's Staycation — Prisma schema
// Target: Turso (libSQL) via Prisma's driver-adapter mode — see src/lib/prisma.ts

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Roles ──────────────────────────────────────────────
// OWNER_ADMIN  — sees every unit and every feature, manages the whole site
// CO_OWNER     — sees only the units assigned to them, same feature set as owner but scoped
// HOUSEKEEPING — sees every feature except the main financial Dashboard
// BOOKER       — logs bookings, uses Calendar; no housekeeping/admin/dashboard
// AUDITOR      — read-only access to the Auditor trail (bookings, payments, housekeeping, bills)
model User {
  id                 String   @id @default(cuid())
  name               String
  username           String   @unique
  email              String?  @unique
  passwordHash       String
  role               String     @default("BOOKER")
  avatarColor        String   @default("#FF385C")
  avatarUrl          String?  // profile picture, data-URL — kept out of the NextAuth session/JWT (would blow the cookie size limit), fetched fresh from the DB wherever it's shown
  // Guest Experience module — opt-in only: a staff member appears on the
  // Digital Guidebook's "Meet our team" card ONLY once Admin explicitly
  // flips this on for them (privacy-conscious default — most staff records
  // exist for internal ops, not public display).
  showOnGuestGuide   Boolean  @default(false)
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // co-owner scoping: which units this user is allowed to see
  ownedUnits   UnitOwner[]
  employee     Employee?
  auditLogs    AuditLog[]
  shifts       Shift[]
  weeklyExpensesAdded WeeklyExpense[]
  reviewedExpenseRequests ExpenseRequest[]
  markedPayrollPayments PayrollPayment[]
  dismissedAttentionItems DismissedAttentionItem[]
  laundryOrdersCreated LaundryOrder[]
  laundryStatusChanges LaundryStatusHistory[]
  laundryPaymentsReceived LaundryPayment[]

  chatConversationMemberships ChatConversationMember[]
  chatMessagesSent            ChatMessage[]
  chatReactions                ChatReaction[]
  chatAnnouncementsCreated    ChatAnnouncement[]
  chatAnnouncementDismissals  ChatAnnouncementDismissal[]
  presence                    UserPresence?

  @@map("users")
}

// Links a CO_OWNER user to the units that belong to them.
model UnitOwner {
  id     String @id @default(cuid())
  userId String
  unitId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@map("unit_owners")
}

model Unit {
  id          String   @id @default(cuid())
  name        String
  unitNumber  String
  shortName   String
  location    String   @default("Cubao, Araneta City")
  nightlyRate Int      @default(1799)
  photoUrl    String?
  rating      Float    @default(4.9)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)

  // Airbnb iCal sync
  icalToken         String?   @unique // powers the public export URL: /api/ical/{icalToken}.ics
  icalImportUrl     String?   // Airbnb (or other platform) .ics feed to import from
  icalLastSyncAt    DateTime?
  icalLastSyncError String?

  // Guest Experience module — per-unit check-in details, shown in the
  // Digital Guidebook (my-bookings/[id]/guide) only to the guest who
  // actually booked this specific unit, never on the public listing page.
  // Admin-editable from the Units tab. All nullable — a unit with none of
  // these set simply omits that guidebook section rather than showing a
  // placeholder.
  wifiSsid            String?
  wifiPassword         String?
  doorCode             String?
  checkInInstructions  String? // free text — e.g. "Elevator to 11F, unit is on your left"
  checkOutInstructions String? // free text — e.g. "Leave keys on the counter, lock the door behind you"
  videoTutorialUrl     String? // optional walkthrough video (YouTube/Drive link)

  // TTLock smart-lock mapping — set once via Admin → Units "Link TTLock
  // lock" (see /api/ttlock/locks), then kept fresh by two feeds: the
  // /api/webhooks/ttlock callback (real-time, on every unlock event) and a
  // daily fallback sync piggybacked on the existing iCal cron. Same
  // inline-nullable-fields convention as the iCal sync fields above, not a
  // child table — a unit with no lock linked simply omits battery UI.
  ttlockLockId            Int?      @unique
  ttlockLockName          String? // TTLock's own lock name, shown in the admin mapping dropdown
  ttlockHasGateway        Boolean? // false/null feeds the "Offline" attention-panel category
  ttlockBatteryPct        Int?
  ttlockBatterySyncedAt   DateTime?
  ttlockSyncError         String?
  ttlockBatteryReplacedAt DateTime? // set via the Units tab "Mark battery replaced" action

  // Monthly Revenue Target override — null means this unit uses
  // Settings.monthlyRevenueTargetPerUnit like every other unit; set only
  // when Admin deliberately wants a different figure for this specific
  // unit (e.g. a smaller/larger room with a genuinely different realistic
  // target).
  monthlyRevenueTargetOverride Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owners        UnitOwner[]
  bookings      Booking[]
  calendarBlocks CalendarBlock[]
  hkState       HousekeepingUnitState?
  cleaningLogs  CleaningLog[]
  stocks        Stock[]
  bills         Bill[]
  auditFindings AuditFinding[]
  recurringExpenseTemplates RecurringExpenseTemplate[]
  icalSyncLogs  IcalSyncLog[]
  expenseRequests ExpenseRequest[]
  guestRequests GuestRequest[]
  laundryOrders LaundryOrder[]
  feedbackResponses FeedbackResponse[]
  reserveAccessCodes ReserveAccessCode[]

  @@map("units")
}

// One row per per-unit Airbnb sync attempt (both the daily cron and the
// Calendar page's manual "Sync Airbnb" button write here) — powers the
// Calendar page's Sync History panel.
model IcalSyncLog {
  id         String       @id @default(cuid())
  unitId     String
  unit       Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  syncType   String
  startedAt  DateTime     @default(now())
  durationMs Int
  imported   Int          @default(0)
  updated    Int          @default(0)
  removed    Int          @default(0)
  conflicts  Int          @default(0)
  ok         Boolean
  error      String?

  @@index([startedAt])
  @@index([unitId, startedAt])
  @@map("ical_sync_log")
}

// Staff directory — populates Booker / Cleaner / Received-by pickers.
// May optionally be linked to a login-capable User.
model Employee {
  id           String   @id @default(cuid())
  name         String
  role         String     @default("BOOKER")
  payRateNote  String?
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // What's actually entered/edited in Admin — a rate at whichever cadence
  // fits how that person is paid (e.g. ₱700/day for housekeeping, ₱1,000/week
  // for a booker, ₱15,000/month for salaried staff).
  salaryType    String @default("MONTHLY")
  salaryRate    Int        @default(0)
  // Derived monthly-equivalent of salaryType+salaryRate — the source of
  // truth every period-scaled payroll figure (weekly/daily/yearly/custom)
  // actually reads, so that machinery doesn't need to know about salaryType
  // at all. Changes are appended to salaryHistory (not overwritten) so past
  // reports keep using the salary that was actually in effect at the time.
  monthlySalary Int @default(0)
  salaryHistory SalaryHistory[]

  bookingsAsBooker    Booking[] @relation("BookerRel")
  bookingsAsCleaner   Booking[] @relation("CleanerRel")
  bookingsAsDpReceiver Booking[] @relation("DpReceiverRel")
  bookingsAsReceiver  Booking[] @relation("ReceiverRel")
  cleaningLogs        CleaningLog[]
  shifts              Shift[]
  targetedExpenses    WeeklyExpense[]
  auditFindings       AuditFinding[]
  eliteBookerAwards   EliteBookerAward[]
  expenseRequests     ExpenseRequest[]
  payrollPayments     PayrollPayment[]
  achievements        EmployeeAchievement[]
  laundryOrdersAssigned LaundryOrder[]

  @@index([active])
  @@map("employees")
}

// Monthly Elite Booker Challenge — company-wide (not per-unit) completed-
// booking milestones (50/100/150/200/250) with LIMITED reward slots (first
// 2, first 2, first 2, first 1, first 1 employees each month). Open to
// anyone who can be assigned as a booking's booker — Bookers, and
// Housekeeping staff who also take bookings at this business — sharing the
// same slot pool, not a separate copy. Persisted the instant a slot is won
// (unique per employee+month+tier) so it's never double-awarded and never
// reassigned later even if a recompute would otherwise reorder who "should"
// have won — once paid, it stays paid. completedAt is the timestamp of the
// exact booking that crossed the tier, used to rank who got there first
// when multiple employees compete for the same limited slots.
model EliteBookerAward {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month       DateTime // first-of-month marker, matching Bill.month's convention
  tier        Int // 50 | 100 | 150 | 200 | 250
  amount      Int // 500 | 1500 | 2500 | 3500 | 5000
  slotRank    Int // 1st or 2nd employee to reach this tier that month (always 1 for Platinum/Legend)
  completedAt DateTime // when the tier-crossing booking completed — the tiebreaker
  createdAt   DateTime @default(now())

  @@unique([employeeId, month, tier])
  @@map("elite_booker_awards")
}

// Append-only log of monthlySalary changes, so a report for a past period
// can look up the salary that was effective then instead of the current
// value — editing today's salary must never rewrite yesterday's numbers.
model SalaryHistory {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  monthlySalary Int
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([employeeId, effectiveDate])
  @@map("salary_history")
}

// A manually-logged cost (e.g. ads, supplies) that can optionally be charged
// against a specific staff member's collected total on the weekly report.
model WeeklyExpense {
  id               String                @id @default(cuid())
  date             DateTime
  amount           Int
  note             String
  targetEmployeeId String?
  targetEmployee   Employee?             @relation(fields: [targetEmployeeId], references: [id], onDelete: SetNull)
  // GENERAL entries targeted at an employee are payroll adjustments (the
  // pre-existing "Salary"/deduction behavior). TIKTOK_ADS is always
  // untargeted — an operational expense that deducts from Net Profit but
  // must never touch anyone's payroll.
  category         String @default("GENERAL")
  addedById        String?
  addedBy          User?                 @relation(fields: [addedById], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())

  @@index([date])
  @@index([category, date])
  @@map("weekly_expenses")
}

// An employee-submitted ad-hoc expense (TikTok ad spend or a unit-specific
// cost) not otherwise covered by the Bill/RecurringExpense system — the
// employee-facing counterpart to Admin's direct-entry Weekly report expense
// tools. Never affects Realized/Forecast profit or payroll until an Owner/
// Admin approves it (see src/components/dashboard/DashboardView.tsx and
// src/app/api/expense-requests/route.ts) — a rejected request is kept, not
// deleted, so the employee can see the reason instead of it silently
// vanishing.
model ExpenseRequest {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category        String    // "TIKTOK_ADS" | "UNIT_EXPENSE"
  unitId          String?   // required for UNIT_EXPENSE, null for TIKTOK_ADS
  unit            Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  amount          Int
  note            String
  receiptUrl      String?   // base64 data-URL, same pattern as Booking.proofUrl/AuditFinding.photoUrl
  date            DateTime
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason String?
  reviewedById    String?
  reviewedBy      User?     @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([status])
  @@index([employeeId])
  @@map("expense_requests")
}

// Record-keeping only — marks whether a given week's payroll (salary +
// commission/day-rate activity) has actually been handed to the employee.
// Purely a status marker the owner toggles from My Earnings' Owner Summary;
// does NOT change how Realized/Forecast profit compute payroll on the
// Dashboard (those keep using the accrued-by-days-elapsed method). `amount`
// is a snapshot of what was actually given, since the live-computed total
// could change later (a rate edit, a corrected booking) without that
// retroactively rewriting what was already paid out.
model PayrollPayment {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart DateTime  // Sunday of the week this covers (same convention as manilaWeekRange)
  amount      Int
  status      String    @default("PENDING") // PENDING | GIVEN
  givenAt     DateTime?
  markedById  String?
  markedBy    User?     @relation(fields: [markedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, periodStart])
  @@map("payroll_payments")
}

// Owner-configurable per-employee achievement — replaces the old hardcoded
// "First Booking / 10 Bookings / 25 Bookings" badges every employee shared
// identically. `threshold` is a lifetime completed-activity count (bookings
// for Bookers, cleaning days for Housekeeping — same count My Earnings
// already tracks for the old badges); `unlocked` is never stored, always
// derived live against real activity, same as before. `rewardAmount` (once
// unlocked) adds to lifetime earnings, same treatment as an Elite Booker
// Challenge bonus. `personalMessage` is only ever shown to the employee
// once they've actually unlocked it — never revealed early.
model EmployeeAchievement {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  label           String
  threshold       Int
  rewardAmount    Int      @default(0)
  personalMessage String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([employeeId])
  @@map("employee_achievements")
}

model Booking {
  id              String        @id @default(cuid())
  unitId          String
  // Restrict, not Cascade — a unit with real booking history must never be
  // deletable out from under that history (would silently destroy revenue
  // records). DELETE /api/units/[id] checks for this up front and returns a
  // friendly error; this is the DB-level backstop for any path that skips
  // that check (a raw script, a future endpoint, etc).
  unit            Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  date            DateTime
  checkOutDate    DateTime?
  stayType        String
  checkInTime     String?
  checkOutTime    String?
  // SQLite/libSQL supports neither a native array column nor Prisma's Json
  // type under the driver-adapters preview — stored as a JSON-encoded
  // string instead. A Prisma Client Extension (src/lib/prisma.ts)
  // transparently parses/stringifies this on every query, so application
  // code still reads and writes it as a plain string[].
  guests          String        @default("[]")
  pax             Int?
  contactNumber   String

  bookerId        String?
  booker          Employee?     @relation("BookerRel", fields: [bookerId], references: [id])
  cleanerId       String?
  cleaner         Employee?     @relation("CleanerRel", fields: [cleanerId], references: [id])

  platform        String
  platformOther   String?

  // Downpayment (reservation fee)
  dpAmount        Int?
  dpReceivedById  String?
  dpReceivedBy    Employee?     @relation("DpReceiverRel", fields: [dpReceivedById], references: [id])
  dpMethod        String?
  dpProofUrl      String?

  // Full / remaining balance payment
  amount          Int
  receivedById    String?
  receivedBy      Employee?     @relation("ReceiverRel", fields: [receivedById], references: [id])
  method          String?
  proofUrl        String?
  paid            Boolean       @default(false)

  // Set via the Booker "Today" quick actions — an actual arrival/departure
  // timestamp, independent of date/checkOutDate (the *planned* stay).
  // Both null until tapped; nothing else in the app depends on them, so
  // they're purely additive.
  checkedInAt     DateTime?
  checkedOutAt    DateTime?

  // Set when this booking was created through the guest-facing Booking
  // Engine (Guest Portal self-service, or a future channel) — null for
  // every staff-logged booking (manual entry, Excel import, Airbnb sync),
  // exactly as today. Purely additive; nothing existing reads this field.
  guestId         String?
  guest           Guest?        @relation(fields: [guestId], references: [id], onDelete: SetNull)
  feedback        FeedbackResponse?
  specialRequest  String?
  // Cancellation — set instead of deleting the row, so a guest still sees a
  // cancelled stay in their booking history, and so staff retain an audit
  // trail rather than the record silently vanishing. A Booker can only ever
  // cancel (not hard-delete) their own bookings — see
  // POST /api/bookings/[id]/cancel — and must always give a reason;
  // OWNER_ADMIN/CO_OWNER still have full DELETE besides. Cancelling alone
  // does NOT reverse commission — see isCommissionEligible() in
  // bookingStatus.ts: money kept (paid, or a down payment on a cancelled
  // booking) still earns commission until the booking is separately marked
  // refunded below.
  cancelledAt       DateTime?
  cancellationReason String?
  // Distinguishes a guest-initiated cancellation (null — the original,
  // still-default meaning of cancelledAt) from a staff-initiated removal:
  // the guest never asked to cancel, staff pulled the booking off the
  // calendar themselves, either because it was a mistaken/duplicate entry
  // (bookerConfusion) or to free the unit for a higher-priority guest
  // (vipReassignment). Rides on the exact same cancelledAt/cancellationReason
  // mechanism — same calendar-freeing, same commission rule (isCommissionEligible
  // in bookingStatus.ts doesn't look at this field) — this is purely a display/
  // reporting distinction, via the dedicated "Remove" action (POST
  // /api/bookings/[id]/cancel with a category) instead of "Cancel booking".
  cancellationCategory String?
  // Refund — independent of cancellation (a booking can be cancelled with
  // the deposit kept, or refunded without being formally cancelled). This is
  // a factual record ("the money was given back"), not a payment action
  // itself — amount/dpAmount/paid are left untouched for audit history, same
  // as cancelledAt leaves them untouched. Only a refund reverses commission
  // (see isCommissionEligible()); a cancellation with the deposit kept does
  // not. Set via POST /api/bookings/[id]/refund, reason always required.
  refundedAt        DateTime?
  refundReason      String?
  // Free-text notes the booker adds when logging a booking (internal, staff-
  // only — distinct from specialRequest above, which is guest-submitted via
  // the Guest Portal booking flow).
  notes             String?

  // Airbnb iCal sync
  source          String @default("MANUAL")
  externalUid     String?       // iCal UID from the imported VEVENT (source = AIRBNB)
  conflict        Boolean       @default(false) // imported booking overlaps an existing confirmed one — flagged, not auto-overwritten

  // Guest Portal: short human-friendly code for email/confirmation-number
  // login (e.g. "EVA-7K2M9X") and for the WiFi/door-code reveal gate —
  // generated for every booking (guest self-service, staff-manual, and
  // bulk import all funnel through createBookingCore). Immutable via the
  // normal edit form/API (not part of bookingSchema) — see
  // confirmationOverrideUntil below for the one deliberate, audited
  // exception (an OWNER_ADMIN reactivating or reissuing it).
  confirmationNumber String? @unique
  // Null = validity is computed automatically from the stay itself (see
  // isConfirmationValid in confirmationValidity.ts — usable from booking
  // creation through checkOutDate/date plus a short grace period, so an
  // extended stay's later checkOutDate is honored automatically with no
  // extra step). Set = an OWNER_ADMIN's explicit "reactivate" override,
  // valid through this exact timestamp regardless of the stay dates —
  // for a guest who legitimately needs access again after their natural
  // window closed.
  confirmationOverrideUntil DateTime?
  // Pre-discount rate total and the promo % applied, from src/lib/pricing/
  // rates.ts's quote at booking time — kept alongside `amount` (which is
  // already net of any discount, same convention as everywhere else in the
  // app) purely so the invoice/booking-detail UI can show "was X, 10% off,
  // now Y" honestly instead of only ever showing the final number.
  originalAmount     Int?
  discountPct        Int?
  // Guest's chosen payment path at booking time — "full" or "down_payment".
  // Deliberately NOT the same signal as dpAmount being set: dpAmount (like
  // every staff booking) is only ever written once a payment is actually
  // confirmed collected, so a guest who picked "down_payment" but hasn't
  // been verified yet still has dpAmount = null and the full amount owed.
  paymentType        String  @default("full")
  // The down-payment figure quoted at booking time (frozen — Settings.dpFee
  // could change later), purely informational until confirmed, at which
  // point it gets copied into the real dpAmount field.
  intendedDpAmount   Int?
  // Result of the AI-assisted payment-screenshot check (Gemini vision) on
  // the most recently uploaded proof — "pending" until first upload,
  // "auto_approved" | "needs_review" | "rejected" after. auto_approved is
  // the only outcome that ever writes dpAmount/paid.
  paymentVerificationStatus String?
  paymentVerificationNote   String?
  // Optional coupon applied at booking time — a snapshot (code + the peso
  // amount it actually knocked off), same convention as originalAmount/
  // discountPct above: independent of and stacked on top of the weekday-
  // night promo, applied after it. No FK to Coupon (denormalized on
  // purpose) so a coupon can be edited/deleted later without altering the
  // historical record of what a past guest actually paid.
  couponCode                String?
  couponDiscountAmount      Int?

  // Guest self-check-in access code — assigned best-effort right after a
  // guest-portal booking is created (never blocks the booking itself; see
  // src/lib/ttlock/reliability.ts). "ttlock" = a real dynamic passcode
  // created live on the lock; "reserve" = one of the 10 pre-provisioned
  // permanent emergency codes per unit, used when the TTLock API call
  // failed after retries. accessCodeKeyboardPwdId is only set for the
  // "ttlock" case, so it can be deleted from the lock on release.
  accessCode                String?
  accessCodeSource          String? // "ttlock" | "reserve"
  accessCodeKeyboardPwdId   Int?
  accessCodeAssignedAt      DateTime?

  calendarBlock   CalendarBlock?  @relation("BookingCalendarBlock")
  cleaningBlock   CalendarBlock?  @relation("BookingCleaningBlock")
  cleaningLogs    CleaningLog[]
  guestRequests   GuestRequest[]
  reserveAccessCode ReserveAccessCode?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([unitId, externalUid])
  @@index([unitId, date])
  @@index([date])
  // Commission/payroll queries (my-earnings, leaderboard, Analytics Staff)
  // filter directly on these — neither is covered by the [unitId, date] or
  // [date] indexes above.
  @@index([bookerId])
  @@index([cleanerId])
  // Every Guest Portal booking list/detail lookup (getGuestBookings,
  // getGuestBookingForGuide, cancel/payment-proof/request ownership
  // checks) filters directly on this — same gap as bookerId/cleanerId
  // above, just never indexed when guestId was added.
  @@index([guestId])
  @@map("bookings")
}

// Idempotency ledger for the one-off legacy-booking migration (evangelinas-p
// .vercel.app -> production). Deliberately a separate table rather than
// fields on Booking itself — the vast majority of bookings were never
// migrated, and this keeps that model untouched. Every legacy record gets
// exactly one row here per legacySourceId+legacyBookingId; a terminal status
// means a re-run skips it, which is what makes the migration script safe to
// run repeatedly.
model BookingMigrationRecord {
  id                  String   @id @default(cuid())
  legacySourceId      String
  legacyBookingId     String
  productionBookingId String?
  status              String
  confidenceScore     Float?
  conflictSeverity    String?
  conflictReason      String?
  migrationBatchId    String
  migrationVersion    String   @default("1.0")
  migratedAt          DateTime @default(now())
  notes               String?

  @@unique([legacySourceId, legacyBookingId])
  @@index([migrationBatchId])
  @@index([status])
  @@map("booking_migration_records")
}

// Airbnb's own reported earnings, imported from the host account's PDF
// earnings reports (not derived from our own Booking records) — a reference
// dataset for reconciling what Airbnb says it paid out against what our own
// bookings show, one row per (month, unit). unitId is null for a
// portfolio-wide monthly total row (the only granularity Airbnb's yearly
// report PDFs give per month — per-unit detail is only available in
// single-month report PDFs). unitId may also reference an Airbnb listing
// that isn't one of this app's tracked Units (the host account manages
// other properties too) — unitLabel preserves Airbnb's own home name/number
// in that case so the row is still readable.
model AirbnbEarningsMonth {
  id                    String   @id @default(cuid())
  month                 DateTime // first-of-month, UTC midnight
  unitId                String? // null = portfolio total for the month
  unitLabel             String? // Airbnb's own "Unit XXXX" label, kept even when unitId can't be matched to a tracked Unit
  grossEarningsCentavos Int
  serviceFeesCentavos   Int // stored positive (magnitude of the fee)
  taxWithheldCentavos   Int
  totalCentavos         Int
  nightsBooked          Int?
  avgNightStay          Float?
  sourceFile            String // originating PDF filename, for audit trail
  importedAt            DateTime @default(now())

  @@index([month])
  @@map("airbnb_earnings_months")
}

// Calendar occupancy blocks: reservations, cleaning holds, maintenance holds.
model CalendarBlock {
  id         String   @id @default(cuid())
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  type       String
  date       DateTime
  endDate    DateTime?
  guest      String?
  note       String?
  status     String   @default("confirmed")
  createdAt  DateTime @default(now())

  // Links this mirrored calendar entry back to the real Booking it was
  // generated from, so edits/deletes on the booking can keep it in sync
  // instead of leaving a stale or orphaned block on the calendar.
  bookingId  String?  @unique
  booking    Booking? @relation("BookingCalendarBlock", fields: [bookingId], references: [id], onDelete: Cascade)

  // Ties the Cleaning-type mirror block to the specific checkout it's
  // cleaning for, so a repeated Start/Finish cycle for the same checkout
  // upserts this one row (via this unique key) instead of piling up
  // duplicate "Cleaned" tiles on the calendar. Null for cleans not tied to
  // a specific checkout (legacy rows, or a room cleaned with nothing
  // scheduled) — those keep the old delete-then-create behavior.
  cleaningBookingId String?  @unique
  cleaningBooking   Booking? @relation("BookingCleaningBlock", fields: [cleaningBookingId], references: [id], onDelete: Cascade)

  @@index([unitId, date])
  @@map("calendar_blocks")
}

// One row per unit: current housekeeping status + checklist progress.
// `checked` mirrors the app's CHECKLIST_GROUPS shape: boolean[][] (group -> item).
model HousekeepingUnitState {
  id        String   @id @default(cuid())
  unitId    String   @unique
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  status    String   @default("todo") // todo | cleaning | clean
  byName    String?
  startedAt DateTime?
  endedAt   DateTime?
  checked   String   @default("[]") // JSON-encoded boolean[][] — see src/lib/prisma.ts extension
  // Every Booking id whose checkout has been cleaned for, accumulated (not
  // overwritten) — a unit can have more than one checkout in a day (e.g. a
  // Daycation guest leaving in the evening AND a separate Night booking
  // leaving that same day), and a single flat status/unit can't otherwise
  // tell those apart. Must be an array: cleaning the second checkout would
  // otherwise silently forget the first one was ever cleaned, wrongly
  // marking it "to clean" again. Not a relation (no onDelete concern) since
  // a deleted booking simply stops being referenced — nothing to cascade.
  cleanedBookingIds String @default("[]") // JSON-encoded string[] — see src/lib/prisma.ts extension
  // Vercel Blob URLs for photos taken during the *current* cleaning session,
  // staged here the same way cleanedBookingIds is — copied onto the
  // resulting CleaningLog.photoUrls when the clean finishes, then cleared on
  // reset. Not base64: this app has repeatedly hit real performance
  // problems from base64-in-DB image fields (Booking proof images, Bill
  // receipts) — a new, taken-every-day photo feature must not repeat that.
  photoUrls String @default("[]") // JSON-encoded string[] — see src/lib/prisma.ts extension
  updatedAt DateTime @updatedAt

  @@map("housekeeping_unit_state")
}

model CleaningLog {
  id         String    @id @default(cuid())
  unitId     String
  // Restrict — cleaning-log history feeds payroll, so a unit that still has
  // logged shifts must never be deletable out from under them. See
  // Booking.unit above.
  unit       Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  startedAt  DateTime
  endedAt    DateTime?
  // Copied in from HousekeepingUnitState.photoUrls when the clean finishes
  // — the permanent record, unlike the state row which gets reset per
  // session. Null (not "[]") for logs written before this field existed.
  photoUrls  String?
  // The specific booking checkout this clean satisfies — lets a repeated
  // "Mark clean" for the same checkout update this same row instead of
  // creating a new one. Null for cleans not tied to a specific checkout
  // (legacy rows, or a room cleaned with nothing scheduled).
  bookingId  String?   @unique
  booking    Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([unitId, startedAt])
  @@index([employeeId])
  @@map("cleaning_logs")
}

model Shift {
  id         String    @id @default(cuid())
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  clockIn    DateTime
  clockOut   DateTime?

  @@map("shifts")
}

model Stock {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name   String
  count  Int    @default(0)

  @@map("stocks")
}

model Bill {
  id         String        @id @default(cuid())
  unitId     String?       // null = a shared/site-wide expense not tied to one unit (e.g. the shared Internet line)
  // Restrict — a unit with real bill/payment history must never be
  // deletable out from under that history. See Booking.unit above.
  unit       Unit?         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  key        String
  label      String?       // display name for a custom bill (key = "custom")
  month      DateTime      // first day of the billing month
  dueDay     Int?          // day-of-month (1-31) this bill is due; null = no set due date
  recurring  Boolean       @default(false) // custom bills only: auto-create next month's instance
  amountDue  Int           @default(0)     // whole pesos — legacy bills only; template-generated bills use amountDueCentavos instead
  amountPaid Int?
  paid       Boolean       @default(false)
  note       String?
  receiptUrl String?
  paidAt     DateTime?

  // Centavo-precise amount for bills generated from a RecurringExpenseTemplate
  // (e.g. ₱18,300.26) — the whole-peso amountDue/amountPaid above can't
  // represent that. Null for ordinary bills, which stay whole-peso as before.
  // Read through billCentavos()/billPaidCentavos() in src/lib/format.ts,
  // never these fields directly, so a bill is correct either way.
  amountDueCentavos  Int?
  amountPaidCentavos Int?
  accountNumber      String? // copied from the template at generation time (e.g. a water utility account number), so it stays correct even if the template later changes

  // Which template generated this instance, if any — lets the monthly
  // generator guarantee "exactly one bill per template per month" with a
  // simple lookup instead of guessing from key+unit+month, and lets a
  // template's own bills be found/updated if the template changes.
  templateId String?
  template   RecurringExpenseTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Not unique: a unit can have any number of custom bills in the same
  // month. The 5 built-in bill types are kept from duplicating themselves
  // by a findFirst-then-create check in the API instead of a DB constraint.
  @@index([unitId, key, month])
  @@index([templateId, month])
  @@map("bills")
}

// The source of truth for a recurring monthly operating expense — Admin
// configures these once, and the monthly Bill-generation pass (see
// generateBillsForMonth in src/lib/recurringExpenses.ts) creates exactly one
// Pending Bill per template per month, carrying its centavo-precise amount
// forward. Editing a template only affects bills generated after the edit —
// already-generated bills (paid or not) are untouched, preserving history.
model RecurringExpenseTemplate {
  id             String    @id @default(cuid())
  category       String
  unitId         String?   // null = shared/site-wide (e.g. Internet)
  unit           Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  description    String
  amountCentavos Int
  accountNumber  String?
  // Fixed day-of-month (1-31), OR a relative rule when there's no fixed day
  // (e.g. "LAST_WEEK" for amortization) — resolved to a concrete day for
  // each month at generation time. Exactly one of the two is set.
  dueDay         Int?
  dueRule        String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  bills          Bill[]

  @@map("recurring_expense_templates")
}

// Auditor quality-inspection findings — cleaning/laundry/booking checks
// logged by an auditor, scored per category, and flagged for the owner to
// review, follow up on, and resolve.
model AuditFinding {
  id                String          @id @default(cuid())
  auditorName       String
  reviewDate        DateTime
  unitId            String?
  unit              Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  employeeId        String?
  employee          Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  category          String
  severity          String
  title             String
  notes             String?
  recommendedAction String?
  cleaningScore     Float?
  laundryScore      Float?
  bookerScore       Float?
  overallStars      Int?
  followUpNeeded    Boolean         @default(false)
  photoUrl          String?
  resolved          Boolean         @default(false)
  resolvedAt        DateTime?
  createdAt         DateTime        @default(now())

  @@index([resolved, severity])
  @@map("audit_findings")
}

// Site-wide settings, managed from the Admin page.
model Settings {
  id            Int      @id @default(1)
  businessName  String   @default("Evangelina's Staycation")
  address       String   @default("Cubao, Quezon City")
  nightlyRate   Int      @default(1799)
  dpFee         Int      @default(500)
  currency      String   @default("PHP")
  checklistGroups String? // JSON-encoded ChecklistGroup[] — see src/lib/prisma.ts extension

  // Guest Experience module — real host contact channels for the
  // guidebook's "Contact Host"/"Message us"/emergency-call buttons. Left
  // null until Admin actually sets them — the guidebook hides/disables the
  // corresponding button rather than ever showing a placeholder number.
  contactPhone          String?
  emergencyContactPhone String?
  messengerUsername     String? // the part after m.me/ — e.g. "EvangelinasStaycation"

  // Brand Kit — Social Media Center export branding. Null until Admin sets
  // them, matching the same "hide/fall back rather than fabricate" pattern
  // as the host fields below — the Social Media Center falls back to the
  // static /branding/logo.jpg and the original hardcoded rausch colors
  // when these are unset, so nothing breaks for an admin who never opens
  // the Brand Kit panel.
  logoUrl             String? // Vercel Blob URL — see src/lib/blob.ts's uploadBrandLogo
  brandPrimaryColor   String? // hex, e.g. "#FF385C"
  brandSecondaryColor String? // hex, e.g. "#B0203A"
  facebookPageUrl     String?
  instagramHandle     String?
  tiktokHandle        String?

  // Guest Experience module — Digital Guidebook content, shared across every
  // unit (nearby places/amenities/house rules don't vary per-unit; per-unit
  // specifics like WiFi/door code live on Unit instead). Same override
  // pattern as checklistGroups above: null falls back to the coded default
  // in src/lib/constants.ts (GUIDEBOOK_CATEGORIES/AMENITIES/HOUSE_RULES), a
  // set value is Admin's edited version — see src/lib/prisma.ts extension.
  guidebookCategories String? // JSON-encoded GuidebookCategory[]
  amenities            String? // JSON-encoded string[]
  houseRules           String? // JSON-encoded string[]

  // Guest Experience module — "Meet your host" card in the Digital
  // Guidebook. All null (hidden) until Admin actually fills these in —
  // never a fabricated bio/photo.
  hostName    String?
  hostPhotoUrl String?
  hostBio      String?

  // Payroll rates — the "Your team" formula on Dashboard/Admin reads these
  // instead of hardcoding them, so Admin can tune pay without a code change.
  housekeepingDayRate    Int @default(700) // per distinct day with a logged cleaning session
  housekeepingNightBonus Int @default(300) // per Night-stay booking they cleaned
  bookerCommission       Int @default(100) // per booking logged
  auditorWeeklyRate      Int @default(0)   // flat weekly rate for Auditor-role staff

  // Guest Portal accommodation rates — Daycation and Night stay (both 12hrs)
  // use the 12h rate, Full stay (21hrs) uses the 21h rate; weekend = Fri/Sat/Sun
  // check-in (Asia/Manila). See src/lib/pricing/rates.ts for the actual quote
  // math — this is the only place these figures live, so Admin can retune
  // them without a code deploy.
  weekdayRate12h         Int @default(1499)
  weekdayRate21h         Int @default(1699)
  weekendRate12h         Int @default(1699)
  weekendRate21h         Int @default(1899)
  // 10% off weekday (Mon-Thu) Night-stay bookings only.
  weekdayNightPromoPct   Int @default(10)
  // Bookings page "Opportunity Engine" — Admin's own target for realized
  // revenue in a single day, shown as a progress bar. Null until an Admin
  // sets one (no fabricated default figure); the panel simply omits the
  // goal progress bar until then, same as this app's other optional-until-
  // configured settings.
  dailyRevenueGoal       Int?
  // Monthly Revenue Target (Dashboard/Analytics "Revenue Goals" panel) —
  // the default per-unit monthly target; a real starting figure (not
  // null-until-set like dailyRevenueGoal above) since the spec asks for
  // ₱50,000/unit/month as the actual working default, adjustable here.
  // Unit.monthlyRevenueTargetOverride below lets an individual unit deviate
  // from this default without changing it for every other unit.
  monthlyRevenueTargetPerUnit Int @default(50000)
  // Extending a stay past checkout, and Flexible stay's own-choice-of-time
  // option — both flat fees, same admin-editable-rate convention as the
  // rate table above. See the Guest Experience "Rates" page.
  extensionFeePerHour    Int @default(100)
  flexibleTimeFee        Int @default(150)
  // Smart Battery Health thresholds (Owner Dashboard) — a unit's
  // ttlockBatteryPct at or below batteryCriticalThresholdPct is Critical,
  // at or below batteryLowThresholdPct is Low, above it is Healthy.
  batteryLowThresholdPct      Int @default(30)
  batteryCriticalThresholdPct Int @default(20)
  // Guest Experience "Parking" page — paid parking, advance reservation
  // required (not a guarantee of availability).
  parkingCarRate         Int @default(400)
  parkingMotorcycleRate  Int @default(300)
  // Guest Experience "Celebrations" FAQ + package card.
  celebrationPackagePrice Int @default(1300)
  celebrationPackageItems String? // JSON-encoded string[]

  // Guest Experience "Emergency" page — named contacts, each with one or
  // more phone numbers (richer than the single emergencyContactPhone
  // above, which stays as the one always-shown number on the Guidebook's
  // compact emergency card).
  emergencyContacts String? // JSON-encoded { name: string; phones: string[] }[]

  // Guest Experience "Contact Us" page — additional named staff a guest can
  // reach directly (e.g. housekeeping, maintenance), separate from the
  // single host contactPhone/messengerUsername above. Same shape/pattern
  // as emergencyContacts.
  staffContacts String? // JSON-encoded { name: string; phones: string[] }[]

  // Guest Experience "FAQs" page — categorized question/answer pairs,
  // same null-falls-back-to-empty pattern as houseRules (Admin fills these
  // in; the app never fabricates an answer it doesn't have).
  faqs String? // JSON-encoded { category: string; items: { q: string; a: string }[] }[]

  // The property's own coordinates (all 5 units are one building) — the
  // fixed origin point PlaceInsight.distanceMeters is measured from. Null
  // until Admin sets it (Nearby place cards just omit distance until then,
  // never a guessed number). See src/lib/places/.
  propertyLat Float?
  propertyLng Float?

  updatedAt     DateTime @updatedAt

  @@map("settings")
}

// Guest Experience "Nearby" pages (NearbyPlacesSection, /guide/nearby/
// [category]) — real, Google-sourced distance/hours/rating for each named
// place in GUIDEBOOK_CATEGORIES, instead of ever guessing. One row per
// (category, name) pair, refreshed on demand by Admin (POST /api/places/
// refresh — never on a schedule, since each refresh is a real, billed
// Google Places API call) via src/lib/places/placeInsightService.ts. A
// place that hasn't been refreshed yet, or whose lookup failed, simply has
// no distance/hours/rating shown — fetchError records why for Admin's
// benefit, it's never surfaced to a guest.
model PlaceInsight {
  id       String @id @default(cuid())
  category String // GuidebookCategory.key, e.g. "coffee"
  name     String // exact item string from that category's items[], e.g. "Starbucks"

  placeId String? // Google place_id, once resolved
  lat     Float?
  lng     Float?
  // Straight-line (haversine) distance from Settings.propertyLat/Lng —
  // deliberately not a claimed walking-route distance, which would need a
  // second billed Directions/Distance Matrix call per place.
  distanceMeters Int?

  rating         Float?
  ratingCount    Int?
  // JSON-encoded string[] — Google's own weekday_text (e.g. "Monday:
  // 9:00 AM – 9:00 PM"), shown as-is, never reformatted/guessed.
  openingHours   String?
  // Snapshot of "open right now" at the moment of the last refresh — can
  // go stale between refreshes, so the UI always pairs it with
  // lastFetchedAt rather than presenting it as live.
  openNow        Boolean?
  // Google's editorial_summary, when it has one — never a generated
  // description standing in for it.
  summary        String?
  businessStatus String? // "OPERATIONAL" | "CLOSED_TEMPORARILY" | "CLOSED_PERMANENTLY"

  // Real walking/driving duration from the property, via the Distance
  // Matrix API (distanceMeters above stays haversine/free — this is the
  // one place an actual route-time call happens, once per refresh).
  walkMinutes  Int?
  driveMinutes Int?
  priceLevel   Int?    // Google's 0 (free) - 4 (very expensive) scale, when it has one
  phoneNumber  String?
  website      String?
  // Google's own photo_reference for this place's first listed photo (not
  // the image itself — see /api/places/photo, which fetches the actual
  // bytes server-side per request using the server-only Places key, so
  // that key never reaches the browser). Null if Google has no photo.
  photoReference String?
  // A short, host-voiced blurb generated once per refresh (Gemini),
  // strictly grounded in this row's own real fields (name, category,
  // distance, rating, Google's summary) — never a claim this data doesn't
  // support. Regenerated every refresh alongside everything else here.
  hostOverview String?

  fetchError    String? // set (and every other field left as-is) when a refresh fails, so a bad lookup doesn't wipe prior good data
  lastFetchedAt DateTime @default(now())

  @@unique([category, name])
  @@index([category])
  @@map("place_insights")
}

// Server-side cache for the Guest View's Unsplash imagery — same
// "never call the live API on a guest page view" discipline as
// PlaceInsight above, just more strict about it: Unsplash's Demo-tier key
// this app uses is capped at 50 requests/hour, which real guest traffic
// would exhaust in minutes if any page load triggered a live search. Every
// guest-facing image read comes from this table; only the cache-warming
// job (piggybacked on the existing daily cron, see src/lib/unsplashSync.ts)
// or an explicit admin refresh ever calls Unsplash directly.
//
// One row per "slot" (our own category key, e.g. "hero", "amenity-coffee",
// "gallery-bedroom", "nearby-restaurants") holding several images at once
// (JSON-encoded array — a slot needs rotation/masonry variety, not a
// single image), fetched in one Unsplash /photos/random?count=N call per
// slot rather than N separate single-photo calls.
model UnsplashImageCache {
  id         String   @id @default(cuid())
  category   String   @unique // our own slot key — see src/lib/unsplash/categories.ts
  query      String   // the actual Unsplash search query used, kept for debugging/re-fetch
  // JSON-encoded UnsplashImage[] (id, regular/full/small/thumb urls,
  // photographer name + profile url, downloadLocation) — parsed/stringified
  // by UnsplashService itself (src/lib/unsplash/service.ts), not the
  // shared Prisma JSON-field extension, since this is this model's only
  // consumer.
  images     String
  fetchError String? // set (existing images left as-is) when a refresh fails — stale-but-real beats a broken slot
  fetchedAt  DateTime @default(now())

  @@map("unsplash_image_cache")
}

// Append-only trail for the Auditor page.
model AuditLog {
  id         String   @id @default(cuid())
  actorUserId String?
  actor      User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action     String   // e.g. "booking.create", "bill.mark_paid", "unit.create"
  entity     String   // e.g. "Booking", "Unit"
  entityId   String?
  meta       String? // JSON-encoded arbitrary object — see src/lib/prisma.ts extension
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

// One row per admin-impersonation session — the authoritative audit trail
// for Settings > Security > Impersonation Logs. Snapshots admin/target
// name+role+username at start time (not just a foreign key) so the log
// stays readable even if a user is later renamed, re-roled, or deleted.
// endedAt null + startedAt older than the 30-minute inactivity window (see
// src/middleware.ts) means the session timed out without an explicit
// "Return to My Account" click — the UI treats those as implicitly ended
// even before a sweep finalizes the row.
model ImpersonationSession {
  id             String    @id @default(cuid())
  adminUserId    String
  adminName      String
  adminUsername  String
  targetUserId   String
  targetName     String
  targetUsername String
  targetRole     String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  durationSeconds Int?
  endReason      String? // "manual" | "timeout" | "admin_logout" | "admin_disabled"
  ipAddress      String?
  userAgent      String?
  reason         String? // optional free-text the admin gave when starting

  @@index([startedAt])
  @@index([adminUserId])
  @@index([targetUserId])
  @@map("impersonation_sessions")
}

// Dashboard "Needs your attention" cards are aggregate/recomputed-every-load
// (e.g. "attn-pastdue" bundles every currently past-due booking into one
// card, not one row per booking), so there's no natural per-record id to
// mark done. Instead `key` is a fingerprint of the item's id + its exact
// description text — dismissing hides that specific combination of
// underlying issues, but the moment the set changes (a new booking goes
// past due, one gets resolved) the fingerprint changes and the card comes
// back, correctly, as a "new" instance of the issue.
model DismissedAttentionItem {
  id            String   @id @default(cuid())
  key           String   @unique
  dismissedById String?
  dismissedBy   User?    @relation(fields: [dismissedById], references: [id], onDelete: SetNull)
  dismissedAt   DateTime @default(now())

  @@map("dismissed_attention_items")
}

// Guest-facing account (Guest Portal) — deliberately a separate model from
// User, not a new role on it. User is staff-only (username+password,
// role-gated internal pages); a Guest authenticates passwordlessly by email
// (GuestLoginToken below) and only ever reaches the public/guest routes.
// The two auth systems share nothing — no session, no cookie, no code path
// — specifically so guest work can never regress staff login.
model Guest {
  id                  String   @id @default(cuid())
  email               String   @unique
  name                String?
  phone               String?
  emailNotifications  Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  bookings      Booking[]
  notifications GuestNotification[]
  requests      GuestRequest[]
  feedbackResponses FeedbackResponse[]

  @@map("guests")
}

// Guest → staff requests raised from the Digital Guidebook (housekeeping,
// late checkout, stay extension, a reported issue) — the reverse direction
// of notificationService.notify() above, which only ever goes staff → guest.
// Deliberately a simple flat record (same shape as AssistantEscalation)
// rather than a full ticketing system — staff see open ones surfaced on the
// Dashboard's existing "Needs your attention" card.
model GuestRequest {
  id         String    @id @default(cuid())
  guestId    String
  guest      Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  bookingId  String
  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  unitId     String
  unit       Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  type       String    // "housekeeping" | "late_checkout" | "extend_stay" | "issue" | "other"
  message    String?
  // Optional photo — a broken fixture, damage, a mess to show rather than
  // describe. Vercel Blob URL, same convention as Booking.proofUrl.
  photoUrl   String?
  // Guest-selected urgency, defaults to normal — lets the dashboard/staff
  // triage a flooding bathroom ahead of a request for extra towels.
  priority   String    @default("normal") // "normal" | "high" | "urgent"
  status     String    @default("pending") // "pending" | "acknowledged" | "resolved"
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@map("guest_requests")
}

// Emergency access-code inventory for the TTLock fallback mechanism (see
// src/lib/ttlock/reliability.ts) — 10 permanent, non-expiring passcodes
// pre-provisioned on each unit's real lock via a one-time admin action
// (never generated dynamically or by a background job). Assigned to a
// booking only when a live TTLock passcode couldn't be created after
// retries, so a guest never ends up without an access code just because
// the TTLock API was down.
model ReserveAccessCode {
  id             String    @id @default(cuid())
  code           String
  unitId         String
  unit           Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  // TTLock's own keyboardPwdId for this permanent code — needed if a code
  // is ever retired/rotated on the lock itself.
  keyboardPwdId  Int?
  // AVAILABLE -> RESERVED (assigned to a booking, guest hasn't arrived yet)
  // -> ACTIVE (guest checked in) -> AVAILABLE again on checkout/release.
  // RESERVED and ACTIVE are functionally identical for reuse purposes
  // (bookingId being set is what blocks reassignment either way) — kept as
  // two states because "reserved for an upcoming guest" and "in active use
  // right now" read very differently on the admin monitoring widget.
  status         String    @default("AVAILABLE")
  bookingId      String?   @unique
  booking        Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  guestId        String?
  assignedAt     DateTime?
  releasedAt     DateTime?
  fallbackReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([unitId, code])
  @@index([unitId, status])
  @@map("reserve_access_codes")
}

// One row logged per fallback activation — a real TTLock API failure that
// caused a reserve code to be used instead of a live-generated passcode.
// Kept separate from ReserveAccessCode itself so the audit trail survives
// even after that code is released/reassigned to a later booking.
model TtlockFallbackLog {
  id           String   @id @default(cuid())
  bookingId    String?
  unitId       String?
  guestId      String?
  errorMessage String
  reserveCodeId String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("ttlock_fallback_logs")
}

// Singleton (id always 1) — the Owner Dashboard's "TTLock API connection
// status" / "Last API failure" fields read this rather than pinging TTLock
// live on every page load. Updated by every real call in
// src/lib/ttlock/reliability.ts's retry wrapper, success or failure.
model TtlockStatus {
  id                 Int       @id @default(1)
  lastSuccessAt      DateTime?
  lastFailureAt      DateTime?
  lastFailureMessage String?
  updatedAt          DateTime  @updatedAt

  @@map("ttlock_status")
}

// Admin-managed discount codes for the Guest Portal booking flow (Settings
// tab). No relation to Booking — a coupon's effect on a specific booking is
// captured as a denormalized snapshot on Booking.couponCode/
// couponDiscountAmount above, so editing or deleting a Coupon here never
// alters historical booking records.
model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  // "percent" (value = 1-100) or "fixed" (value = a peso amount)
  type        String
  value       Int
  // null = unlimited uses
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  active      Boolean   @default(true)
  description String?
  createdAt   DateTime  @default(now())

  @@map("coupons")
}

// Guest Feedback & Rewards — a 5-step post-stay survey (src/app/guide/
// feedback/[bookingId]) that unlocks a one-time reward on submission. One
// response per booking (bookingId is @unique) — enforced at the DB level,
// not just client-side, so a duplicate/replayed POST can never mint a
// second reward for the same completed stay. The ₱100-off reward reuses
// the real Coupon model above (a genuine, single-use Coupon row is created
// and its own code is what's shown here) — deliberately no FK relation to
// Coupon, same denormalized-snapshot convention Booking.couponCode already
// uses, so editing/deleting a Coupon later never corrupts historical
// feedback records. The other two reward types (late checkout, coffee) are
// redeemed in person by staff — redeemedAt lets Admin mark them used.
model FeedbackResponse {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guestId   String
  guest     Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  overallRating Int // 1 (Poor) .. 5 (Excellent)
  // JSON-encoded string[] — same TEXT-column pattern as Booking.guests
  // (see the Prisma Client Extension in src/lib/prisma.ts).
  likedTags      String  @default("[]")
  improveComment String?
  wouldRecommend String // "definitely" | "probably" | "maybe" | "no"

  rewardType       String // "discount" | "late_checkout" | "coffee"
  voucherCode      String    @unique
  voucherExpiresAt DateTime
  redeemedAt       DateTime?

  contactName  String
  contactPhone String
  contactEmail String?

  createdAt DateTime @default(now())

  @@index([guestId])
  @@index([unitId])
  @@map("feedback_responses")
}

// In-app inbox for the events notificationService.notify() already fires
// (booking created/updated/cancelled, payment received) — this is the
// "display booking updates" half of that seam; the "prepare for future
// push notifications" half is the existing empty push/notificationclick
// stubs in public/sw.js, unwired until there's a real channel to trigger
// them from.
model GuestNotification {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  type      String
  message   String
  bookingId String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([guestId, createdAt])
  @@map("guest_notifications")
}

// One-time-use email magic-link tokens. Deliberately its own tiny table
// instead of NextAuth's EmailProvider/adapter machinery — that provider
// requires a database adapter (Account/Session/User tables matching its own
// schema), which would mean migrating the existing JWT-only staff auth onto
// an adapter just to get guest login. This is a few plain columns instead.
model GuestLoginToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("guest_login_tokens")
}

// A guest tapping "Talk to a human" in the AI Assistant, or the assistant
// itself deciding it can't help — a lightweight, staff-visible record
// (no dedicated staff UI yet; queryable directly for now) rather than a
// full support-ticket system, since nothing like that existed before this.
model AssistantEscalation {
  id         String    @id @default(cuid())
  guestId    String?
  bookingId  String?
  question   String
  contactInfo String?
  resolved   Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@map("assistant_escalations")
}

// ── Laundry Management (part of the Housekeeping module — no separate nav) ──
// A configurable, priced laundry service — Admin/Owner-managed, same
// active-flag/null-falls-back-to-hidden convention as everything else
// Admin configures in this app. pricePerKg and pricePerItem are each
// optional but at least one must be set (enforced in validation, not the
// DB) — an order priced by weight uses pricePerKg x totalWeight, one priced
// per piece (e.g. a single suit sent for dry cleaning) uses pricePerItem x
// totalQuantity.
model LaundryService {
  id                    String   @id @default(cuid())
  name                  String
  description           String?
  pricePerKg            Int?     // whole pesos per kilogram
  pricePerItem          Int?     // whole pesos per piece
  estimatedTurnaroundHours Int   @default(24)
  active                Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  orders LaundryOrder[]

  @@map("laundry_services")
}

// A laundry ticket — deliberately independent of Booking/Guest (a laundry
// customer is very often a walk-in or a guest whose stay isn't tracked as
// a Booking at all), so roomNumber/customerName/contactNumber are their
// own plain fields here rather than a required FK to Unit/Guest. unitId is
// an optional soft link for when the order genuinely is for a current
// in-house guest, purely to make "which unit" filterable/reportable — nothing
// else in the app depends on it being set.
model LaundryOrder {
  id            String    @id @default(cuid())
  orderNumber   String    @unique // "LDY-000123", sequential — see laundryOrderNumber.ts

  customerName  String
  roomNumber    String?
  unitId        String?
  unit          Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  contactNumber String

  dateReceived  DateTime  @default(now())
  dueDate       DateTime

  serviceId     String
  service       LaundryService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  assignedStaffId String?
  assignedStaff Employee? @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)

  // Totals — auto-computed from items + the chosen service's rate when
  // items change (see laundryPricing.ts), but stored (not purely derived)
  // so staff can override for a negotiated/rounded price, same convention
  // as Booking.amount being an editable field seeded from a computed quote.
  totalWeight   Float     @default(0) // kilograms
  totalQuantity Int       @default(0)
  subtotal      Int       @default(0) // service rate x weight/quantity, before adjustments
  discountAmount Int      @default(0)
  additionalCharges Int   @default(0)
  taxAmount     Int       @default(0)
  totalAmount   Int       @default(0) // subtotal - discount + additionalCharges + taxAmount

  // paymentStatus (Unpaid/Partial/Paid) is deliberately NOT a stored column
  // — always derived from totalAmount vs. the sum of this order's
  // LaundryPayment rows (see laundryPricing.ts's paymentStatusFor), so it
  // can never drift out of sync the way a separately-maintained flag could.
  payments      LaundryPayment[]

  status        String    @default("Received") // Received | Washing | Drying | Ironing | Folding | Ready for Pickup | Delivered | Cancelled
  statusHistory LaundryStatusHistory[]

  notes         String?
  cancelledAt   DateTime?
  cancellationReason String?

  items         LaundryItem[]

  createdById   String?
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([dateReceived])
  @@index([dueDate])
  @@index([unitId])
  @@index([assignedStaffId])
  @@map("laundry_orders")
}

model LaundryItem {
  id          String   @id @default(cuid())
  orderId     String
  order       LaundryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  itemName    String
  category    String // e.g. "Shirt", "Bedding", "Towel" — free text, not a fixed enum (a laundry business's item list varies too much to hardcode)
  quantity    Int      @default(1)
  weight      Float?   // kilograms, optional (small/mixed loads are often priced by weight of the whole order, not itemized)
  color       String?
  condition   String? // e.g. "Good", "Stained", "Delicate" — free text
  specialInstructions String?

  @@index([orderId])
  @@map("laundry_items")
}

// Full status-change trail — every transition, who made it, and an
// optional note. The order's own `status` field always mirrors the most
// recent row here (kept redundant on the order for cheap filtering/
// indexing — see LaundryOrder.status — but this table is the source of
// truth for "when" and "who").
model LaundryStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     LaundryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  changedById String?
  changedBy User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  notes     String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("laundry_status_history")
}

// One row per payment transaction against an order — supports partial
// payments accumulating toward totalAmount (see LaundryOrder's comment on
// why paymentStatus is derived from these rows, not a separate flag).
model LaundryPayment {
  id            String   @id @default(cuid())
  orderId       String
  order         LaundryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Int
  method        String // Cash | GCash | BankTransfer | Card | OtherWallet
  receivedById  String?
  receivedBy    User?    @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@map("laundry_payments")
}

// ── Team Communication Hub ─────────────────────────────
// TEAM = one fixed all-staff conversation (auto-provisioned, every active
// staff member is a member). GROUP = a fixed set of role-based rooms
// (Bookers/Housekeeping/Admins — seeded from this app's real roles, not
// invented departments). DM = exactly 2 members, no `name` (derived from
// the other participant client-side).
model ChatConversation {
  id        String   @id @default(cuid())
  type      String   // "TEAM" | "GROUP" | "DM"
  name      String?
  createdAt DateTime @default(now())

  members  ChatConversationMember[]
  messages ChatMessage[]

  @@map("chat_conversations")
}

// lastReadAt is the one thing that makes unread badges/read-receipts work
// without a per-message-per-user row: "read" means every message with
// createdAt <= lastReadAt.
model ChatConversationMember {
  id             String    @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  favorited      Boolean   @default(false)
  muted          Boolean   @default(false)
  joinedAt       DateTime  @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("chat_conversation_members")
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  // A #EVA-XXXXXXX-shaped confirmation number found in `body` at send time
  // — resolved server-side once, so the rich booking card never has to
  // re-parse free text on every render and can't drift from what the
  // sender actually typed.
  bookingRef     String?
  replyToId      String?
  replyTo        ChatMessage? @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[] @relation("ChatMessageReplies")
  imageUrl       String?  // Vercel Blob URL, same upload pattern as everywhere else in this app
  editedAt       DateTime?
  deletedAt      DateTime? // soft delete — the row (and its audit trail) is never actually removed
  pinned         Boolean  @default(false)
  createdAt      DateTime @default(now())

  reactions ChatReaction[]

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model ChatReaction {
  id        String   @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@map("chat_reactions")
}

// Admin broadcasts — pinned team-wide until each recipient dismisses their
// own copy (ChatAnnouncementDismissal), never edited/deleted from under
// anyone.
model ChatAnnouncement {
  id          String   @id @default(cuid())
  body        String
  category    String   @default("ANNOUNCEMENT") // ANNOUNCEMENT | URGENT | MAINTENANCE | POLICY
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  dismissals ChatAnnouncementDismissal[]

  @@map("chat_announcements")
}

model ChatAnnouncementDismissal {
  id             String   @id @default(cuid())
  announcementId String
  announcement   ChatAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dismissedAt    DateTime @default(now())

  @@unique([announcementId, userId])
  @@map("chat_announcement_dismissals")
}

// One row per user — status is the last explicit state (manual, or "ONLINE"
// promoted by a heartbeat ping); lastActiveAt is what actually decides
// whether someone reads as online/away/offline at render time (see
// presenceStatus() in src/lib/chat/presence.ts) — a stale ping always wins
// over a stored "ONLINE" from before someone closed their laptop.
model UserPresence {
  userId                 String    @id
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                 String    @default("OFFLINE") // ONLINE | BUSY | AWAY | DND | MEETING | OFFLINE
  statusNote             String?
  device                 String?   // "desktop" | "mobile" — from the heartbeat's own client hint
  lastActiveAt           DateTime  @default(now())
  typingInConversationId String?
  typingAt               DateTime?

  @@map("user_presence")
}
