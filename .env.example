# Neon Postgres connection string.
# In the Neon dashboard: Project -> Connection Details -> copy the "pooled" string for DATABASE_URL
# and the "direct" (unpooled) string for DIRECT_URL (used by Prisma Migrate).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/evangelinas?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/evangelinas?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
